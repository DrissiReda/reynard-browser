+
+// Reynard: system alerts backend for iOS. nsAlertsService hands web
+// notifications here; the app shows them with UNUserNotificationCenter and
+// reports taps back with GeckoView:WebNotification:Click.
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  EventDispatcher: "resource://gre/modules/Messaging.sys.mjs",
+});
+
+export class GeckoViewAlerts {
+  // name -> { alert, callbacks }
+  #alerts = new Map();
+
+  constructor() {
+    lazy.EventDispatcher.instance.registerListener(this, [
+      "GeckoView:WebNotification:Click",
+    ]);
+  }
+
+  showAlert(alert, observer) {
+    this.showAlertWithCallbacks(alert, {
+      onAlertShow: () => observer?.observe(null, "alertshow", alert.cookie),
+      onAlertClick: action =>
+        observer?.observe(action, "alertclickcallback", alert.cookie),
+      onAlertFinished: () =>
+        observer?.observe(null, "alertfinished", alert.cookie),
+      onAlertClosed: () => observer?.observe(null, "alertfinished", "close"),
+    });
+  }
+
+  showAlertWithCallbacks(alert, callbacks) {
+    this.#alerts.set(alert.name, { alert, callbacks });
+    lazy.EventDispatcher.instance.sendRequest("GeckoView:WebNotification:Show", {
+      name: alert.name,
+      id: alert.id,
+      title: alert.title,
+      text: alert.text,
+      imageURL: alert.imageURL,
+      origin: alert.origin,
+      source: alert.source,
+      silent: alert.silent,
+      requireInteraction: alert.requireInteraction,
+      privateBrowsing: alert.inPrivateBrowsing,
+    });
+    callbacks?.onAlertShow?.();
+  }
+
+  closeAlert(name) {
+    const entry = this.#alerts.get(name);
+    this.#alerts.delete(name);
+    lazy.EventDispatcher.instance.sendRequest(
+      "GeckoView:WebNotification:Close",
+      { name }
+    );
+    entry?.callbacks?.onAlertFinished?.();
+  }
+
+  getHistory() {
+    return [];
+  }
+
+  teardown() {
+    this.#alerts.clear();
+  }
+
+  pbmTeardown() {}
+
+  isFullscreen() {
+    return false;
+  }
+
+  onEvent(event, data) {
+    if (event != "GeckoView:WebNotification:Click") {
+      return;
+    }
+    const entry = this.#alerts.get(data.name);
+    if (entry) {
+      this.#alerts.delete(data.name);
+      const action = data.action
+        ? entry.alert.getAction(data.action)
+        : null;
+      entry.callbacks?.onAlertClick?.(action);
+      entry.callbacks?.onAlertFinished?.();
+      return;
+    }
+    // Not shown in this run (e.g. the app was relaunched by the tap): let
+    // Gecko find the service worker for this notification and fire
+    // notificationclick, or open the origin.
+    try {
+      const principal =
+        Services.scriptSecurityManager.createContentPrincipalFromOrigin(
+          data.origin
+        );
+      Cc["@mozilla.org/notification-handler;1"]
+        .getService(Ci.nsINotificationHandler)
+        .respondOnClick(principal, data.id, data.action ?? "", true);
+    } catch (e) {
+      console.error("Reynard: notification click failed", e);
+    }
+  }
+}
+
+GeckoViewAlerts.prototype.QueryInterface = ChromeUtils.generateQI([
+  "nsIAlertsService",
+]);
